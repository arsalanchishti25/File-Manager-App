# =================================================================
# File Manager App - Environment Configuration Template
# Copy this file to .env before starting the system.
# DO NOT commit .env with real production secrets to version control.
# =================================================================

# -----------------------------------------------------------------
# 1. General & Network
# -----------------------------------------------------------------
SERVICE_ID=main-app-1
SERVICE_TYPE=main-app
DOCKER_NETWORK=filemanager-network

# -----------------------------------------------------------------
# 2. MQTT Broker
# -----------------------------------------------------------------
# URL format: tcp://<host>:<port>
MQTT_BROKER_URL=tcp://filemanager-mqtt:1883
MQTT_CLIENT_ID=main-app-1

# -----------------------------------------------------------------
# 3. Central MySQL Database (Metadata Store)
# -----------------------------------------------------------------
MYSQL_HOST=filemanager-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=filemanager
MYSQL_USER=fileapp
# [DEVELOPMENT PLACEHOLDER ONLY] Set a secure password in production
MYSQL_PASSWORD=fileapp123

# -----------------------------------------------------------------
# 4. SFTP File Transfer Credentials
# Used for inter-service chunk transfers between Main App, Aggregator, and File Storage.
# -----------------------------------------------------------------
# [DEVELOPMENT PLACEHOLDER ONLY] Set secure credentials in production
SFTP_USER=sftpuser
SFTP_PASSWORD=sftppass123

# -----------------------------------------------------------------
# 5. Main App (JavaFX GUI & Local Cache)
# -----------------------------------------------------------------
MAIN_APP_ID=main-app-1
SQLITE_DB_PATH=/app/data/fileapp.db
APP_DATA_DIR=/app/data

# -----------------------------------------------------------------
# 6. Aggregator Service
# -----------------------------------------------------------------
AGGREGATOR_ID=agg-1
AGGREGATOR_WORK_DIR=/app/data
# Legacy alias for backward compatibility:
# WORKING_DIR=/app/data
# AES-256 Key: 32 bytes ASCII or 64-char Hex or 44-char Base64
# [DEVELOPMENT PLACEHOLDER ONLY - 32 ASCII bytes]
ENCRYPTION_KEY=12345678901234567890123456789012

# -----------------------------------------------------------------
# 7. File Storage Containers (VG1 - VG4)
# -----------------------------------------------------------------
FS_CONTAINER_ID=fs-1
VOLUME_GROUP=1
STORAGE_PORT=8082
SFTP_PORT=2201
STORAGE_DATA_DIR=/storage/data
# Legacy alias for backward compatibility:
# STORAGE_BASE_PATH=/storage/data

# -----------------------------------------------------------------
# 8. Host Manager (Docker Orchestrator)
# -----------------------------------------------------------------
HOST_MANAGER_ID=hm-1
FILE_STORAGE_IMAGE=file-manager/file-storage:latest
AGGREGATOR_IMAGE=file-manager/aggregator:latest
# DOCKER_HOST=unix:///var/run/docker.sock
