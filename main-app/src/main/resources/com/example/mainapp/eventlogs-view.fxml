<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.mainapp.controller.EventLogsController">

    <center>
        <!-- <Label fx:id="statusLabel" styleClass="status-label"/>
        <TableView fx:id="logsTable">
            <columns>
                <TableColumn fx:id="timeColumn" text="Time" prefWidth="160"/>
                <TableColumn fx:id="userColumn" text="User" prefWidth="120"/>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/>
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="400"/>
            </columns>
        </TableView> -->
        <VBox spacing="5">
            <Label fx:id="statusLabel" styleClass="status-label"/>
            <TableView fx:id="logsTable">
                <columns>
                    <TableColumn fx:id="timeColumn" text="Time" prefWidth="160"/>
                    <TableColumn fx:id="userColumn" text="User" prefWidth="120"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="120"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="400"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Refresh" onAction="#onRefreshClicked"/>
            <Button text="Back to Files" onAction="#onBackClicked"/>
        </HBox>
    </bottom>

</BorderPane>
