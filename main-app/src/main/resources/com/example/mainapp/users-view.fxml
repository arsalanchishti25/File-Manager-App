<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.mainapp.controller.UsersController">

    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="User Management"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <Label fx:id="statusLabel" styleClass="status-label"/>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10">
                <Button text="Add User" onAction="#onAddUserClicked"/>
                <Button text="Promote/Demote User" onAction="#onPromoteDemoteClicked"/>
                <Button text="Delete Selected" onAction="#onDeleteUserClicked"/>
            </HBox>

            <TableView fx:id="usersTable" prefHeight="400">
                <columns>
                    <TableColumn fx:id="usernameColumn" text="Username" prefWidth="200"/>
                    <TableColumn fx:id="hashedPasswordColumn" text= "Hashed Password" prefWidth="200"/>
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="150"/>
                    <TableColumn fx:id="createdColumn" text="Created" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Back to Files" onAction="#onBackClicked"/>
        </HBox>
    </bottom>
</BorderPane>
