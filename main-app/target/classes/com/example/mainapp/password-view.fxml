<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.mainapp.controller.UpdatePasswordController"
      spacing="15" 
      alignment="CENTER"
      styleClass="container">
    
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    
    <!-- Title -->
    <Label text="Update Password" styleClass="title">
        <font>
            <Font name="System Bold" size="24"/>
        </font>
    </Label>
    
    <!-- Form Container -->
    <GridPane hgap="10" vgap="15" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120"/>
            <ColumnConstraints minWidth="250" prefWidth="250"/>
        </columnConstraints>
        
        <!-- Current Password -->
        <Label text="Current Password:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <PasswordField fx:id="currentPasswordField" 
                       promptText="Enter current password"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <!-- New Password -->
        <Label text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <PasswordField fx:id="newPasswordField" 
                       promptText="Enter new password"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        
        <!-- Confirm Password -->
        <Label text="Confirm Password:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <PasswordField fx:id="confirmPasswordField" 
                       promptText="Confirm new password"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>
    
    <!-- Status Message -->
    <Label fx:id="statusLabel" textFill="#d32f2f" wrapText="true" maxWidth="370"/>
    
    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Update Password" 
                onAction="#handleUpdatePassword"
                prefWidth="150"
                styleClass="primary-button"/>
        <Button text="Cancel" 
                onAction="#handleCancel"
                prefWidth="100"
                styleClass="secondary-button"/>
    </HBox>
    
</VBox>
