- MySQL Initialization Script for File Manager

CREATE DATABASE IF NOT EXISTS filemanager;
USE filemanager;

-- Users table
CREATE TABLE IF NOT EXISTS users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role ENUM('STANDARD', 'ADMIN') DEFAULT 'STANDARD',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    -- updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    -- INDEX idx_username(username),
    -- INDEX idx_role(role)
);

-- Files table
CREATE TABLE IF NOT EXISTS files (
    id INT AUTO_INCREMENT PRIMARY KEY,
    -- file_id VARCHAR(255) UNIQUE NOT NULL,
    owner_id INT NOT NULL,
    filename VARCHAR(255) NOT NULL,
    size_in_bytes BIGINT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    last_modified DATETIME DEFAULT CURRENT_TIMESTAMP, -- ON UPDATE CURRENT_TIMESTAMP
    -- chunk_metadata JSON,
    -- status ENUM('UPLOADING', 'READY', 'DELETED') DEFAULT 'READY',
    FOREIGN KEY (owner_id) REFERENCES users(id) ON DELETE CASCADE,
);

-- File chunks table (tracks where each chunk is stored)
CREATE TABLE IF NOT EXISTS file_chunks (
    id INT AUTO_INCREMENT PRIMARY KEY,
    file_id INT NOT NULL,
    chunk_order INT NOT NULL,
    storage_location VARCHAR(255),
    crc32_checksum VARCHAR(255),
    volume_group VARCHAR(100),
    FOREIGN KEY(file_id) REFERENCES files(id)
    -- chunk_index INT NOT NULL,
    -- container_id BIGINT NOT NULL,
    -- checksum VARCHAR(255) NOT NULL,
    -- created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    -- FOREIGN KEY (file_id) REFERENCES files(file_id) ON DELETE CASCADE,
    -- FOREIGN KEY (container_id) REFERENCES containers(id),
    -- UNIQUE KEY unique_chunk(file_id, chunk_index),
    -- INDEX idx_file(file_id)
);

-- Containers table (tracks all running containers)
CREATE TABLE IF NOT EXISTS containers (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    container_ip VARCHAR(45),
    status VARCHAR(50),
    created_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    last_health_check DATETIME,
    load_score INT DEFAULT 0,
    container_type VARCHAR(50),
    volume_group VARCHAR(100),
    assigned_port INT
);

-- Permissions table (file sharing)
CREATE TABLE IF NOT EXISTS file_permissions (
    permission_id INT AUTO_INCREMENT PRIMARY KEY,
    file_id INT NOT NULL,
    user_id INT NOT NULL,
    permission_type VARCHAR(50) NOT NULL,
    FOREIGN KEY(file_id) REFERENCES files(id) ON DELETE CASCADE,
    FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE,
);

-- Event logs table (audit trail)
CREATE TABLE IF NOT EXISTS event_logs (
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    event_type VARCHAR(100),
    description TEXT,
    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE SET NULL,
);

